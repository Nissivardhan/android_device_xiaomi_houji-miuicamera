 2 files changed, 65 insertions(+)
 create mode 100644 smali_classes2/com/android/camera/compat/LeicaClientName.smali

diff --git a/smali_classes2/I9/b.smali b/smali_classes2/I9/b.smali
index 2d33c586..ec5a94c2 100644
--- a/smali_classes2/I9/b.smali
+++ b/smali_classes2/I9/b.smali
@@ -97,6 +97,8 @@
 
     monitor-exit p2
 
+    invoke-static {p0}, Lcom/android/camera/compat/LeicaClientName;->a(Landroid/hardware/camera2/CaptureRequest$Builder;)V
+
     return-object p0
 
     :catchall_0
diff --git a/smali_classes2/com/android/camera/compat/LeicaClientName.smali b/smali_classes2/com/android/camera/compat/LeicaClientName.smali
new file mode 100644
index 00000000..11111111
--- /dev/null
+++ b/smali_classes2/com/android/camera/compat/LeicaClientName.smali
@@ -0,0 +1,63 @@
+.class public final Lcom/android/camera/compat/LeicaClientName;
+.super Ljava/lang/Object;
+.source "SourceFile"
+
+
+.method public static final a(Landroid/hardware/camera2/CaptureRequest$Builder;)V
+    .registers 5
+
+    :try_start_0
+    new-instance v0, Landroid/hardware/camera2/CaptureRequest$Key;
+
+    const-string v1, "com.xiaomi.sessionparams.clientName"
+
+    const-class v2, [B
+
+    invoke-direct {v0, v1, v2}, Landroid/hardware/camera2/CaptureRequest$Key;-><init>(Ljava/lang/String;Ljava/lang/Class;)V
+
+    const/16 v1, 0x13
+
+    new-array v1, v1, [B
+
+    fill-array-data v1, :array_38
+
+    invoke-virtual {p0, v0, v1}, Landroid/hardware/camera2/CaptureRequest$Builder;->set(Landroid/hardware/camera2/CaptureRequest$Key;Ljava/lang/Object;)V
+    :try_end_20
+    .catch Ljava/lang/RuntimeException; {:try_start_0 .. :try_end_20} :catch_22
+
+    return-void
+
+    :catch_22
+    move-exception p0
+
+    const-string v0, "MiuiCameraClientName"
+
+    const-string v1, "Unable to inject Leica camera client name"
+
+    invoke-static {v0, v1, p0}, Landroid/util/Log;->e(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)I
+
+    return-void
+
+    :array_38
+    .array-data 1
+        0x63t
+        0x6ft
+        0x6dt
+        0x2et
+        0x61t
+        0x6et
+        0x64t
+        0x72t
+        0x6ft
+        0x69t
+        0x64t
+        0x2et
+        0x63t
+        0x61t
+        0x6dt
+        0x65t
+        0x72t
+        0x61t
+        0x0t
+    .end array-data
+.end method
